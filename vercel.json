{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": "data/deck.json" } },
    { "src": "web/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/fonts/(.*)", "dest": "/web/static/fonts/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/static/(crests|brand)/(.*)", "dest": "/web/static/$1/$2",
      "headers": { "cache-control": "public, max-age=2592000, stale-while-revalidate=604800" } },
    { "src": "/static/(.*\\.(?:css|js))", "dest": "/web/static/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/static/manifest\\.webmanifest", "dest": "/web/static/manifest.webmanifest",
      "headers": { "content-type": "application/manifest+json", "cache-control": "public, max-age=3600" } },
    { "src": "/static/(.*)", "dest": "/web/static/$1" },
    { "src": "/favicon.ico", "dest": "/web/static/brand/favicon-32.png" },
    { "src": "/sw.js", "dest": "/web/static/sw.js",
      "headers": { "cache-control": "no-cache", "service-worker-allowed": "/", "content-type": "text/javascript; charset=utf-8" } },

    { "src": "/api/(.*)", "dest": "api/index.py" },

    { "src": "/", "dest": "/web/static/index.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/start", "dest": "/web/static/start.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/draft", "dest": "/web/static/draft.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/cup", "dest": "/web/static/cup.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/archive", "dest": "/web/static/archive.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/friends", "dest": "/web/static/friends.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/room", "dest": "/web/static/room.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/about", "dest": "/web/static/about.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/faq", "dest": "/web/static/faq.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/privacy", "dest": "/web/static/privacy.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/terms", "dest": "/web/static/terms.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/offline", "dest": "/web/static/offline.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/admin", "dest": "/web/static/admin.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/analysis", "dest": "/web/static/analysis.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/daily", "dest": "/web/static/daily.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/profile", "dest": "/web/static/profile.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/squad", "dest": "/web/static/squad.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } },
    { "src": "/dynasty", "dest": "/web/static/dynasty.html", "headers": { "cache-control": "public, max-age=0, must-revalidate" } }
  ]
}
